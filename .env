# --- Database ---
DATABASE_URL=postgresql://peblo:peblo@db:5432/peblo_tv_mini

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- Storage ---
# local | r2 (r2 not yet implemented — see app/storage.py header comment)
STORAGE_BACKEND=local
STORAGE_ROOT=/data/storage

# --- R2 (only needed once STORAGE_BACKEND=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Production secrets management: these would live in the platform's secret
# store (e.g. Fly.io secrets, AWS SSM Parameter Store, or Doppler) and get
# injected as env vars at deploy time — never committed, never baked into
# the image. JWT_SECRET and R2 credentials rotate independently of a code
# deploy, so CI never needs to see the real values, only staging/test ones.
